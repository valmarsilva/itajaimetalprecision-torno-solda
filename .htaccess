# Configuração Itajaí Metal - Hostinger
Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Forçar HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Se o arquivo existir no disco, entrega ele diretamente
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Caso contrário, manda para o index.html (essencial para React Router/SPA)
  RewriteRule ^ index.html [L]
</IfModule>

# Garantir MIME Types para evitar erro text/plain
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType application/javascript .mjs
  AddType application/javascript .tsx
  AddType application/javascript .jsx
</IfModule>

# Desativar Sniffing para evitar que o navegador bloqueie o Babel
<IfModule mod_headers.c>
  Header set Access-Control-Allow-Origin "*"
</IfModule>